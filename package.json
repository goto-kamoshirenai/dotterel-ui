{
  "name": "dotterel-ui",
  "version": "0.4.1",
  "description": "A lightweight, customizable React UI library built from dots.",
  "license": "MIT",
  "author": "goto-kamoshirenai",
  "homepage": "https://github.com/goto-kamoshirenai/dotterel-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goto-kamoshirenai/dotterel-ui.git"
  },
  "bugs": {
    "url": "https://github.com/goto-kamoshirenai/dotterel-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "icons",
    "dot",
    "pixel",
    "animation",
    "countup",
    "counter",
    "font",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js",
      "default": "./dist/button/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./count": {
      "types": "./dist/count/index.d.ts",
      "import": "./dist/count/index.js",
      "default": "./dist/count/index.js"
    },
    "./effects": {
      "types": "./dist/effects/index.d.ts",
      "import": "./dist/effects/index.js",
      "default": "./dist/effects/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "import": "./dist/icon/index.js",
      "default": "./dist/icon/index.js"
    },
    "./progress": {
      "types": "./dist/progress/index.d.ts",
      "import": "./dist/progress/index.js",
      "default": "./dist/progress/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "import": "./dist/text/index.js",
      "default": "./dist/text/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.9.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "check": "pnpm check:lib && pnpm showcase:check",
    "check:lib": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:built && pnpm pack --dry-run",
    "font:generate": "node scripts/generate-font.mjs",
    "lint": "eslint .",
    "showcase:build": "pnpm --dir showcase build",
    "showcase:check": "pnpm --dir showcase check",
    "showcase:dev": "pnpm --dir showcase dev",
    "showcase:test": "pnpm --dir showcase test",
    "showcase:test:e2e": "pnpm --dir showcase test:e2e",
    "test": "pnpm build && pnpm test:built",
    "test:built": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fonteditor-core": "^2.6.3",
    "globals": "^16.5.0",
    "opentype.js": "^2.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
